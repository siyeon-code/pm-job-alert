# 사용법: 이 파일을 복사해서 .env 파일을 만들고, = 뒤에 실제 값을 붙여넣으세요.
# .env는 .gitignore에 들어 있어서 GitHub에 올라가지 않습니다.
# 이 예시 파일(.env.example)에는 실제 값을 절대 적지 마세요.

# 사람인 API access-key
SARAMIN_ACCESS_KEY=

# 슬랙 Incoming Webhook URL (4단계에서 사용)
SLACK_WEBHOOK_URL=

# 공공데이터포털(data.go.kr) 일반 인증키(Decoding) — 공공기관 채용정보 API에 사용
DATA_GO_KR_SERVICE_KEY=
